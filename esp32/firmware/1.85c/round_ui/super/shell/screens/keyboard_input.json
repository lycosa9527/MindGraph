{
    "type": "viewScreen",
    "mount_mode": "dynamic",
    "id": "keyboard_input",
    "commonProps": {
        "clickable": true,
        "scrollable": false
    },
    "placement": {
        "width": "${env.widthDp}",
        "height": "${env.heightDp}"
    },
    "children": [
        {
            "type": "container",
            "id": "backdrop",
            "commonProps": {
                "clickable": true
            },
            "events": [
                {
                    "type": "clicked",
                    "action": "super.keyboard.cancel.backdrop"
                }
            ],
            "placement": {
                "width": "${env.widthDp}",
                "height": "${env.heightDp}"
            },
            "styleRefs": [
                "shell.keyboardBackdrop"
            ]
        },
        {
            "type": "container",
            "id": "input_bar",
            "commonProps": {
                "clickable": true,
                "hidden": true,
                "scrollable": false
            },
            "bindings": {
                "commonProps.hidden": "inputHidden"
            },
            "placement": {
                "x": "${constant.ui.keyboard.marginX}",
                "y": "${expr(${env.heightDp} - ${constant.ui.keyboard.marginBottom} - ${constant.ui.keyboard.keyboardHeight} - ${constant.ui.keyboard.popoverHeight} - ${constant.ui.keyboard.inputGap} - ${constant.ui.keyboard.inputHeight})}",
                "width": "${expr(${env.widthDp} - ${constant.ui.keyboard.marginX} * 2)}",
                "height": "${constant.ui.keyboard.inputHeight}"
            },
            "styleRefs": [
                "shell.keyboardInput"
            ],
            "children": [
                {
                    "type": "textInput",
                    "id": "input",
                    "bindings": {
                        "textInputProps.text": "text",
                        "textInputProps.placeholder": "placeholder",
                        "textInputProps.password": "password",
                        "textInputProps.maxLength": "maxLength"
                    },
                    "textInputProps": {
                        "text": "",
                        "placeholder": "",
                        "password": false,
                        "multiline": false,
                        "maxLength": 128
                    },
                    "events": [
                        {
                            "type": "valueChanged",
                            "action": "super.keyboard.text_changed"
                        },
                        {
                            "type": "ready",
                            "action": "super.keyboard.submit.input"
                        },
                        {
                            "type": "cancel",
                            "action": "super.keyboard.cancel.input"
                        }
                    ],
                    "placement": {
                        "x": 0,
                        "y": 0,
                        "width": "${expr(${env.widthDp} - ${constant.ui.keyboard.marginX} * 2 - ${constant.ui.keyboard.okButtonWidth} - ${constant.ui.keyboard.eyeButtonSize} - ${constant.ui.keyboard.eyeInset} * 2)}",
                        "height": "match"
                    },
                    "styleRefs": [
                        "shell.keyboardInputField"
                    ],
                    "style": {
                        "fontSize": "${constant.ui.keyboard.inputFontSize}"
                    }
                },
                {
                    "type": "container",
                    "id": "password_toggle",
                    "interactionRefs": [
                        "press.scale"
                    ],
                    "commonProps": {
                        "clickable": true,
                        "scrollable": false
                    },
                    "bindings": {
                        "commonProps.hidden": "passwordToggleHidden"
                    },
                    "events": [
                        {
                            "type": "clicked",
                            "action": "super.keyboard.toggle_password"
                        }
                    ],
                    "layout": {
                        "type": "flex",
                        "mainAlign": "center",
                        "crossAlign": "center"
                    },
                    "placement": {
                        "x": "${expr(${env.widthDp} - ${constant.ui.keyboard.marginX} * 2 - ${constant.ui.keyboard.okButtonWidth} - ${constant.ui.keyboard.eyeButtonSize} - ${constant.ui.keyboard.eyeInset})}",
                        "y": 0,
                        "width": "${constant.ui.keyboard.eyeButtonSize}",
                        "height": "match"
                    },
                    "children": [
                        {
                            "type": "image",
                            "id": "icon",
                            "commonProps": {
                                "clickable": false
                            },
                            "bindings": {
                                "imageProps.src": "passwordIcon"
                            },
                            "imageProps": {
                                "src": "${image.icon.eyeHide}",
                                "innerAlign": "contain"
                            },
                            "placement": {
                                "width": "${constant.ui.keyboard.eyeIconSize}",
                                "height": "${constant.ui.keyboard.eyeIconSize}"
                            },
                            "styleRefs": [
                                "shell.keyboardEyeButton"
                            ]
                        }
                    ]
                },
                {
                    "type": "button",
                    "id": "done",
                    "interactionRefs": [
                        "press.scale"
                    ],
                    "events": [
                        {
                            "type": "clicked",
                            "effects": [
                                {
                                    "type": "emitAction",
                                    "action": "super.keyboard.submit.input",
                                    "requireValidPress": true
                                }
                            ]
                        }
                    ],
                    "layout": {
                        "type": "flex",
                        "mainAlign": "center",
                        "crossAlign": "center"
                    },
                    "placement": {
                        "x": "${expr(${env.widthDp} - ${constant.ui.keyboard.marginX} * 2 - ${constant.ui.keyboard.okButtonWidth})}",
                        "y": 0,
                        "width": "${constant.ui.keyboard.okButtonWidth}",
                        "height": "match"
                    },
                    "children": [
                        {
                            "type": "label",
                            "commonProps": {
                                "clickable": false
                            },
                            "labelProps": {
                                "text": "OK"
                            },
                            "style": {
                                "fontSize": "${constant.ui.keyboard.keyFontSize}"
                            }
                        }
                    ],
                    "styleRefs": [
                        "shell.keyboardKeyAction"
                    ]
                }
            ]
        },
        {
            "type": "container",
            "id": "keyboard_panel",
            "commonProps": {
                "clickable": true,
                "hidden": true,
                "scrollable": false
            },
            "bindings": {
                "commonProps.hidden": "keyboardHidden"
            },
            "placement": {
                "x": "${constant.ui.keyboard.marginX}",
                "y": "${expr(${env.heightDp} - ${constant.ui.keyboard.keyboardHeight} - ${constant.ui.keyboard.popoverHeight} - ${constant.ui.keyboard.marginBottom})}",
                "width": "${expr(${env.widthDp} - ${constant.ui.keyboard.marginX} * 2)}",
                "height": "${expr(${constant.ui.keyboard.keyboardHeight} + ${constant.ui.keyboard.popoverHeight})}"
            },
            "children": [
                {
                    "type": "keyboard",
                    "id": "keyboard",
                    "bindings": {
                        "keyboardProps.mode": "mode",
                        "keyboardProps.allowedModes": "allowedModes"
                    },
                    "keyboardProps": {
                        "mode": "text",
                        "allowedModes": [
                            "text",
                            "upper",
                            "number",
                            "special"
                        ],
                        "popovers": false,
                        "iconSize": "${constant.ui.keyboard.iconSize}",
                        "targetTextInput": "/keyboard_input/input_bar/input",
                        "keyStyleRefs": {
                            "default": "shell.keyboardKeyDefault",
                            "special": "shell.keyboardKeySpecial",
                            "mode": "shell.keyboardKeyMode",
                            "action": "shell.keyboardKeyAction",
                            "disabled": "shell.keyboardKeyDisabled"
                        },
                        "layouts": {
                            "text": [
                                [{"text": "1"}, {"text": "2\nABC"}, {"text": "3\nDEF"}],
                                [{"text": "4\nGHI"}, {"text": "5\nJKL"}, {"text": "6\nMNO"}],
                                [{"text": "7\nPQRS"}, {"text": "8\nTUV"}, {"text": "9\nWXYZ"}],
                                [
                                    { "text": "EN", "role": "mode", "mode": "upper" },
                                    { "text": "0", "role": "space" },
                                    { "text": "⌫", "role": "backspace" }
                                ]
                            ],
                            "upper": [
                                [{"text": "1"}, {"text": "2\nABC"}, {"text": "3\nDEF"}],
                                [{"text": "4\nGHI"}, {"text": "5\nJKL"}, {"text": "6\nMNO"}],
                                [{"text": "7\nPQRS"}, {"text": "8\nTUV"}, {"text": "9\nWXYZ"}],
                                [
                                    { "text": "中", "role": "mode", "mode": "text" },
                                    { "text": "0", "role": "space" },
                                    { "text": "⌫", "role": "backspace" }
                                ]
                            ],
                            "number": [
                                ["1", "2", "3"],
                                ["4", "5", "6"],
                                ["7", "8", "9"],
                                [
                                    { "text": "中", "role": "mode", "mode": "text" },
                                    "0",
                                    { "text": "⌫", "role": "backspace" }
                                ]
                            ],
                            "special": [
                                [
                                    { "text": "-", "styleClass": "special" },
                                    { "text": "/", "styleClass": "special" },
                                    { "text": ":", "styleClass": "special" }
                                ],
                                [
                                    { "text": "@", "styleClass": "special" },
                                    { "text": "#", "styleClass": "special" },
                                    { "text": ".", "styleClass": "special" }
                                ],
                                [
                                    { "text": "_", "styleClass": "special" },
                                    { "text": "+", "styleClass": "special" },
                                    { "text": "=", "styleClass": "special" }
                                ],
                                [
                                    { "text": "中", "role": "mode", "mode": "text" },
                                    { "text": "123", "role": "mode", "mode": "number" },
                                    { "text": "⌫", "role": "backspace" }
                                ]
                            ]
                        }
                    },
                    "events": [
                        {
                            "type": "ready",
                            "action": "super.keyboard.submit.keyboard"
                        },
                        {
                            "type": "cancel",
                            "action": "super.keyboard.cancel.keyboard"
                        }
                    ],
                    "placement": {
                        "mode": "relative",
                        "align": "topLeft",
                        "y": "${constant.ui.keyboard.popoverHeight}",
                        "width": "match",
                        "height": "${constant.ui.keyboard.keyboardHeight}"
                    },
                    "style": {
                        "fontSize": "${constant.ui.keyboard.keyFontSize}"
                    },
                    "styleRefs": [
                        "shell.keyboardPanel"
                    ]
                }
            ]
        }
    ]
}
