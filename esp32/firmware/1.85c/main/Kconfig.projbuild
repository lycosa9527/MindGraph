menu "MindGraph 1.85C station"

    config MINDGRAPH_STA_SSID
        string "Home AP SSID (empty disables boot connect)"
        default ""
        help
            Seeded at boot after a full-flash (NVS is wiped at 0x00).
            Prefer sdkconfig.defaults.local so the password stays untracked.

    config MINDGRAPH_STA_PASSWORD
        string "Home AP password"
        default ""
        help
            Used only when MINDGRAPH_STA_SSID is non-empty.

    config MINDGRAPH_STA_TIMEZONE
        string "POSIX timezone for the status clock"
        default "CST-8"
        help
            Settings China option is CST-8 (UTC+8). Applied at boot so the
            clock is not UTC after NVS is wiped.

    config MINDGRAPH_KITTY_SERVER_URL
        string "MindGraph origin for Kitty watch (https://host or http://host:9527)"
        default ""
        help
            Used by the mobile-lane Kitty client. Prefer sdkconfig.defaults.local.

    config MINDGRAPH_KITTY_MGAT
        string "Baked mgat_ API token (required for Kitty watch)"
        default ""
        help
            Watch auth is flash-time only. Prefer sdkconfig.defaults.local.
            Do not commit. Empty means the watch cannot authenticate.

    config MINDGRAPH_KITTY_ACCOUNT
        string "X-MG-Account phone for baked mgat_"
        default ""
        help
            Phone bound to the baked token. Prefer sdkconfig.defaults.local.

endmenu
