# ============================================================================
# MINDGRAPH ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and configure for your deployment.
# Advanced / rarely-changed knobs (MindBot, Kitty, collab, IP reputation, RAG, …):
#   docs/ops/env-advanced.md
# Secrets stay in .env only — never commit .env.

# ============================================================================
# APPLICATION
# ============================================================================
HOST=0.0.0.0
PORT=9527
DEBUG=False
# development | test | production (default). Non-production bypasses some startup guards / admin SMS.
# ENVIRONMENT=production
# EXTERNAL_HOST=your-public-ip-address
# EXTERNAL_BASE_URL=https://your-domain.com
LOG_LEVEL=INFO
VERBOSE_LOGGING=False
GRAPH_LANGUAGE=zh
DEFAULT_LANGUAGE=zh
WATERMARK_TEXT=MindGraph

# ============================================================================
# LLM (DashScope / Volcengine ARK)
# ============================================================================
# Workspace MaaS: apiKey → QWEN_API_KEY; workspaceId → DASHSCOPE_WORKSPACE_ID.
# Optional ASR/TTS key: DASHSCOPE_API_KEY (defaults to QWEN_API_KEY).
# URL / Omni / rate-limit details: docs/ops/env-advanced.md#llm-and-rate-limits
QWEN_API_KEY=your-workspace-api-key-here
DASHSCOPE_WORKSPACE_ID=llm-your-workspace-id
DASHSCOPE_REGION=cn-beijing
QWEN_MODEL_CLASSIFICATION=qwen3.6-flash
QWEN_MODEL_GENERATION=qwen3.6-flash
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_RERANK_MODEL=qwen3-rerank
DASHSCOPE_QPM_LIMIT=13500
DASHSCOPE_CONCURRENT_LIMIT=500
DASHSCOPE_RATE_LIMITING_ENABLED=false

ARK_API_KEY=your-ark-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_DEEPSEEK_ENDPOINT=ep-20250101000000-dummy
ARK_KIMI_ENDPOINT=ep-20250101000000-dummy
ARK_DOUBAO_ENDPOINT=ep-20250101000000-dummy
KIMI_VOLCENGINE_QPM_LIMIT=4500
KIMI_VOLCENGINE_CONCURRENT_LIMIT=500
DOUBAO_VOLCENGINE_QPM_LIMIT=27000
DOUBAO_VOLCENGINE_CONCURRENT_LIMIT=500
DEEPSEEK_VOLCENGINE_QPM_LIMIT=13500
DEEPSEEK_VOLCENGINE_CONCURRENT_LIMIT=500
LOAD_BALANCING_RATE_LIMITING_ENABLED=true
LOAD_BALANCING_ENABLED=true
LOAD_BALANCING_STRATEGY=round_robin
LOAD_BALANCING_WEIGHTS=dashscope:50,volcengine:50

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_MINDMATE=False
# Kitty Agent = former voice agent (canvas + Fun-ASR + CosyVoice + Omni). Not FEATURE_VOICE_AGENT (removed).
# Tuning: docs/ops/env-advanced.md#kitty-agent
FEATURE_KITTY_AGENT=True
FEATURE_DRAG_AND_DROP=False
FEATURE_COURSE=False
FEATURE_MATE_LEARNING=False
FEATURE_TEMPLATE=False
FEATURE_COMMUNITY=False
FEATURE_SHOWCASE=True
FEATURE_ASKONCE=True
FEATURE_DEBATEVERSE=False
FEATURE_KNOWLEDGE_SPACE=False
FEATURE_MINDMAP_V2_CANVAS=True
FEATURE_LIBRARY=False
FEATURE_MARKETS=False
# DingTalk HTTP robot → per-org Dify. Tuning: docs/ops/env-advanced.md#mindbot
FEATURE_MINDBOT=True
FEATURE_OAUTH_LOGIN=False
WECHAT_OAUTH_APP_ID=
WECHAT_OAUTH_APP_SECRET=
FEATURE_MINDMATE_EXPORT=False
FEATURE_THINKING_COINS=False
FEATURE_GEWE=False
FEATURE_RAG_CHUNK_TEST=False
FEATURE_SMART_RESPONSE=False
# Required when FEATURE_SMART_RESPONSE=True (ESP32 X-Device-Registration-Secret).
DEVICE_REGISTRATION_SECRET=
FEATURE_TEACHER_USAGE=False
FEATURE_WORKSHOP_CHAT=False
FEATURE_MINDMATE_COLLAB=False
FEATURE_MCP_HTTP=False
# Optional loopback-only override for MCP tool → REST (default http://127.0.0.1:$PORT).
# Non-loopback values are ignored. See docs/operations/mcp_http.md.
# MCP_HTTP_INTERNAL_BASE_URL=http://127.0.0.1:9527
FEATURE_AUTH_PIXEL_BATTLE=False
FEATURE_TEST_SERVER_BANNER=False
WORKSHOP_CHAT_PREVIEW_ORG_IDS=

# ============================================================================
# DIFY / MINDMATE
# ============================================================================
DIFY_API_KEY=your_dify_api_key_here
DIFY_API_URL=https://api.dify.ai/v1
DIFY_TIMEOUT=300
GEN_SESSION_TTL_SECONDS=600
AI_ASSISTANT_NAME=教学设计
# MindBot admin Dify online probe (optional). More: docs/ops/env-advanced.md#mindbot
# MINDBOT_DIFY_HEALTH_BASE_URL=https://dify.mindspringedu.com/v1
# MINDBOT_DIFY_HEALTH_API_KEY=

# ============================================================================
# GEWE (when FEATURE_GEWE=True)
# ============================================================================
GEWE_TOKEN=your_gewe_token_here
GEWE_BASE_URL=http://api.geweapi.com
GEWE_TIMEOUT=30
GEWE_WEBHOOK_SECRET=
GEWE_WEBHOOK_ALLOWED_IPS=

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
# See docs/POSTGRES_SETUP.md. After Alembic RLS (0044+), prefer mindgraph_app + DATABASE_MIGRATION_URL.
DATABASE_URL=postgresql://mindgraph_user:mindgraph_password@localhost:5432/mindgraph
# DATABASE_MIGRATION_URL=postgresql://mindgraph_migrate:mindgraph_password@localhost:5432/mindgraph
POSTGRESQL_MANAGED_BY_APP=true
POSTGRESQL_DATA_DIR=./storage/postgresql
POSTGRESQL_PORT=5432
POSTGRESQL_USER=mindgraph_user
POSTGRESQL_PASSWORD=mindgraph_password
POSTGRESQL_DATABASE=mindgraph
POSTGRESQL_MAX_CONNECTIONS=175

# ============================================================================
# TOKEN TRACKING
# ============================================================================
TOKEN_TRACKER_ENABLED=true
TOKEN_TRACKER_BATCH_SIZE=1000
TOKEN_TRACKER_BATCH_INTERVAL=300
TOKEN_TRACKER_MAX_BUFFER_SIZE=10000
USER_DAILY_TOKEN_CAP=5000000

# ============================================================================
# DIAGRAM STORAGE
# ============================================================================
DIAGRAM_CACHE_TTL=604800
DIAGRAM_SYNC_INTERVAL=300
DIAGRAM_SYNC_BATCH_SIZE=100
DIAGRAM_MAX_PER_USER=20
DIAGRAM_MAX_SPEC_SIZE_KB=500

# ============================================================================
# BACKUP
# ============================================================================
BACKUP_ENABLED=true
BACKUP_HOUR=3
BACKUP_RETENTION_COUNT=2
BACKUP_DIR=backup

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT_SECRET_KEY is auto-generated in Redis (not required in .env).
ACCESS_TOKEN_EXPIRY_MINUTES=60
MAX_CONCURRENT_SESSIONS=2
AUTH_MODE=standard
# Behind a reverse proxy: TRUSTED_PROXY_IPS=private
TRUSTED_PROXY_IPS=
FORCE_SECURE_COOKIES=false
# ADMIN_PHONES / ADMIN_USER_IDS grant superadmin — leave empty on public production.
ADMIN_PHONES=
ADMIN_USER_IDS=
ENTERPRISE_DEFAULT_ORG_CODE=DEMO-001
ENTERPRISE_DEFAULT_USER_PHONE=enterprise@system.com
BAYI_PASSKEY=CHANGE-ME-before-production
BAYI_DECRYPTION_KEY=CHANGE-ME-before-production
BAYI_DEFAULT_ORG_CODE=BAYI-001
BAYI_CLOCK_SKEW_TOLERANCE=10
INVITATION_CODES=DEMO-001:DEM-9K2:never

# ============================================================================
# TENCENT CLOUD (SMS / SES / COS)
# ============================================================================
# One SecretId/SecretKey pair is reused by SMS, SES (fallback), and COS.
# Rate-limit windows / WeCom / Alipay / COS sync: docs/ops/env-advanced.md#tencent-and-notifications
TENCENT_SMS_SECRET_ID=your-tencent-secret-id-here
TENCENT_SMS_SECRET_KEY=your-tencent-secret-key-here
TENCENT_SMS_SDK_APP_ID=1400000000
TENCENT_SMS_SIGN_NAME=MindGraph
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_TEMPLATE_REGISTER=1234567
TENCENT_SMS_TEMPLATE_LOGIN=1234568
TENCENT_SMS_TEMPLATE_RESET_PASSWORD=1234569
TENCENT_SMS_TEMPLATE_ALERT=12345678
TENCENT_SMS_TEMPLATE_STARTUP=123456
SMS_CODE_EXPIRY_MINUTES=5
SMS_RESEND_INTERVAL_SECONDS=60
SMS_RATE_LIMITING_ENABLED=true
SMS_STARTUP_NOTIFICATION_ENABLED=true

TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_HOST=ses.ap-hongkong.tencentcloudapi.com
TENCENT_SES_FROM_EMAIL=
TENCENT_SES_REPLY_TO=
TENCENT_SES_TEMPLATE_ID=123456
EMAIL_CODE_EXPIRY_MINUTES=10
EMAIL_RATE_LIMITING_ENABLED=true

COS_BUCKET=your-bucket-name-appid
COS_REGION=ap-beijing
COS_BACKUP_ENABLED=false
COS_KEY_PREFIX=backups/mindgraph-CHANGE
COS_DOCUMENTS_ENABLED=true
COS_DOCUMENTS_PREFIX=documents/mindgraph
COS_SHOWCASE_ENABLED=true
COS_SHOWCASE_PREFIX=showcase/mindgraph
COS_SYNC_ENABLED=false
COS_SYNC_ROLE=off
# Shared mirror prefix for blocklists / Qdrant / Celery / Playwright / GeoLite
# COS_SYNC_KEY_PREFIX=backups/mindgraph-shared
# Optional: pin Playwright package version recorded in COS meta (default = installed)
# PLAYWRIGHT_TARGET_VERSION=1.61.0
# Playwright COS also mirrors Ubuntu apt .deb deps under sync/playwright/apt-deps/
# (distro-specific, e.g. ubuntu24.04-x64). Consumer install prefers COS debs, then apt.

# ============================================================================
# REDIS & CELERY (required)
# ============================================================================
# See docs/REDIS_SETUP.md and docs/CELERY_SETUP.md
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CELERY_DB=1
CELERY_MANAGED_BY_APP=true
# Worker CLI + Python logger level (info avoids pidbox DEBUG spam in celery_worker_error.log)
CELERY_WORKER_LOGLEVEL=info
PRELOAD_USER_AUTH_CACHE=true

# ============================================================================
# PROCESS / HEALTH / ALERTS
# ============================================================================
PROCESS_MONITOR_ENABLED=true
HEALTH_MONITOR_ENABLED=true
CRITICAL_ALERT_ENABLED=true
ERROR_COLLECTION_ENABLED=true
ERROR_RETENTION_DAYS=90
ERROR_ALERT_ENABLED=true
# ADMIN_SMS_ALERTS_ENABLED=false

# ============================================================================
# KNOWLEDGE SPACE / QDRANT
# ============================================================================
# Required when FEATURE_KNOWLEDGE_SPACE=True. See docs/QDRANT_SETUP.md
# Chunking / retrieval knobs: docs/ops/env-advanced.md#knowledge-rag
QDRANT_HOST=localhost:6333
QDRANT_COLLECTION_PREFIX=user_
QDRANT_COMPRESSION=SQ8
KNOWLEDGE_STORAGE_DIR=./storage/knowledge_documents
MAX_DOCUMENTS_PER_USER=5
MAX_FILE_SIZE=10485760
MAX_STORAGE_PER_USER=52428800
MAX_CHUNKS_PER_USER=1000
CHUNKING_ENGINE=semchunk
FILE_CENTER_WIKI_COMPILE=true

# ============================================================================
# MISC
# ============================================================================
WECHAT_QR_IMAGE=
# Canvas workshop / collab (Redis 8+): docs/ops/env-advanced.md#online-collab
# IP reputation (AbuseIPDB / CrowdSec): docs/ops/env-advanced.md#ip-reputation
#   also docs/FAIL2BAN_SETUP.md
# Launch copy-paste commands:
#   python -m services.infrastructure.utils.launch_commands
